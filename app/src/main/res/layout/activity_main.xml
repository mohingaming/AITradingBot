<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/screen_bg"
    android:padding="28dp">

    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/logo"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="AI TRADING BOT"
        android:textColor="#00E5FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"/>

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:background="@drawable/field_bg"
        android:hint="API Key (Inception)"
        android:textColor="#FFFFFF"
        android:textColorHint="#88FFFFFF"
        android:padding="14dp"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_bg"
        android:text="SAVE API KEY"
        android:textColor="#FFFFFF"/>

    <ToggleButton
        android:id="@+id/botToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_bg"
        android:textColor="#FFFFFF"
        android:textOn="BOT ON"
        android:textOff="BOT OFF"/>

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_bg"
        android:text="1. ALLOW OVERLAY PERMISSION"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_bg"
        android:text="2. ENABLE ACCESSIBILITY SERVICE"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Setup koro"
        android:textColor="#88FFFFFF"/>
</LinearLayout>
